library(ggforce)
# 1. Save original compute_group
compute_group_orig <- ggforce:::StatEllip$compute_group
# 2. Create patched version
compute_group_fixed <- function(data, scales, expand = 0, radius = NULL, n = 100, ...) {
# If fewer than 3 points, fall back to original
if (nrow(data) < 3) {
return(compute_group_orig(data, scales, expand = expand, radius = radius, n = n, ...))
}
# Extract raw points
pts <- cbind(data$x, data$y)
# Compute covariance and eigenvectors
S <- cov(pts)
eig <- eigen(S)
# --- PATCH: enforce stable orientation ---
# Ensure major axis is first
if (eig$values[1] < eig$values[2]) {
eig$vectors <- eig$vectors[, c(2,1)]
eig$values  <- eig$values[c(2,1)]
}
# Compute angle
angle <- atan2(eig$vectors[2,1], eig$vectors[1,1])
# Prevent 180-degree flips
if (eig$vectors[1,1] < 0) {
angle <- angle + pi
}
# Call original function
res <- compute_group_orig(data, scales, expand = expand, radius = radius, n = n, ...)
# Overwrite angle
res$angle <- angle
res
}
# 3. Inject patched version into ggforce
ggforce:::StatEllip$compute_group <- compute_group_fixed
