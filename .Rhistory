library(ggplot2)
library(dplyr)
library(stringr)
library(vegan)
library(Rtsne)
library(phyloseq)
# ===================================================================
# --- 2. DATA PREPARATION FUNCTIONS ---
# ===================================================================
# Prepares the phyloseq object and extracts the analysis dataframe
prepare_dataset_phyloseq <- function(rds_file, fertilizers_to_keep, n_asvs_target) {
if (!file.exists(rds_file)) stop("Error: RDS file not found.")
pseq <- readRDS(rds_file)
# Metadata Modification
meta <- as.data.frame(sample_data(pseq))
meta$TimePeriod <- NA_character_
meta$TimePeriod[meta$Time %in% c("11DAS", "14DAS", "17DAS", "31DAS")] <- "early"
meta$TimePeriod[meta$Time %in% c("158DAS", "187DAS", "215DAS", "227DAS")] <- "middle"
meta$TimePeriod[meta$Time %in% c("256DAS", "318DAS")] <- "late"
meta$TimePeriod <- factor(meta$TimePeriod, levels = c("early", "middle", "late"))
meta$Block <- as.factor(str_extract(meta$Sample, "(?<=\\.\\D)(\\d+)"))
sample_data(pseq) <- meta
# Filtering
samples_to_keep <- sample_names(pseq)[!is.na(get_variable(pseq, "TimePeriod")) &
get_variable(pseq, "Fertilizer") %in% fertilizers_to_keep]
pseq_filtered <- prune_samples(samples_to_keep, pseq)
pseq_filtered <- prune_taxa(taxa_sums(pseq_filtered) > 0, pseq_filtered)
# Select Top N ASVs
top_ASVs <- names(sort(taxa_sums(pseq_filtered), decreasing = TRUE))[1:min(n_asvs_target, ntaxa(pseq_filtered))]
pseq_final <- prune_taxa(top_ASVs, pseq_filtered)
final_features <- if (taxa_are_rows(pseq_final)) as.data.frame(t(otu_table(pseq_final))) else as.data.frame(otu_table(pseq_final))
final_metadata <- as.data.frame(sample_data(pseq_final))
return(data.frame(final_features, response_var = final_metadata$TimePeriod,
Fertilizer = final_metadata$Fertilizer, Time = final_metadata$Time))
}
# Helper to isolate numeric features from metadata
prepare_plot_data <- function(data, metadata_cols) {
feature_data <- data[, !names(data) %in% metadata_cols, drop = FALSE]
metadata <- data[, metadata_cols, drop = FALSE]
feature_data_numeric <- data.frame(lapply(feature_data, function(x) as.numeric(as.character(x))))
rownames(feature_data_numeric) <- rownames(data)
return(list(features = feature_data_numeric[rowSums(feature_data_numeric) > 0, ],
metadata = metadata[rowSums(feature_data_numeric) > 0, ]))
}
calculate_plot_tsne_final <- function(data, metadata_cols, seed = 42, perplexity = 30) {
prep <- prepare_plot_data(data, metadata_cols)
dist_matrix <- vegan::vegdist(prep$features, method = "bray")
set.seed(seed)
tsne_res <- Rtsne::Rtsne(dist_matrix, is_distance = TRUE, dims = 2,
perplexity = min(perplexity, floor((nrow(prep$features) - 1) / 3)))
df <- data.frame(tsne_res$Y, prep$metadata)
colnames(df)[1:2] <- c("Dim1", "Dim2")
# Order Factors
time_lvls <- c("11DAS", "14DAS", "17DAS", "31DAS", "158DAS", "187DAS", "215DAS", "227DAS", "256DAS", "318DAS")
df$Time <- factor(df$Time, levels = intersect(time_lvls, unique(df$Time)))
df$response_var <- factor(df$response_var, levels = c("early", "middle", "late"))
# Color Palette (Red -> Orange -> Yellow -> Green -> Blue -> Purple)
ref_colors <- c("#800026", "#bd0026", "#e31a1c", "#fc4e2a", "#fd8d3c", "#feb24c", "#fed976", "#c7e9b4", "#7fcdbb", "#41b6c4", "#1d91c0", "#225ea8", "#0c2c84", "#4b0082")
time_palette <- colorRampPalette(ref_colors)(length(levels(df$Time)))
# Plot
ggplot(df, aes(x = Dim1, y = Dim2)) +
stat_ellipse(aes(fill = response_var), geom = "polygon", alpha = 0.12, color = "black", linewidth = 0.2) +
geom_point(aes(color = Time, shape = Fertilizer), size = 2.2, alpha = 0.9) +
scale_color_manual(values = time_palette, name = "Time") +
scale_fill_manual(values = c("early" = "#e0f3f8", "middle" = "#e6f5d0", "late" = "#fee0d2"),
name = "Growth period", labels = c("Early", "Middle", "Late")) +
scale_shape_manual(values = c("M1P1" = 16, "N1K1" = 17, "N1P2K2" = 15), name = "Fertility Level") +
scale_y_continuous(breaks = seq(-20, 20, by = 10)) +
scale_x_continuous(breaks = seq(-20, 20, by = 10)) +
labs(x = "t-SNE 1", y = "t-SNE 2", title = paste("Bray-Curtis | Perplexity:", perplexity)) +
theme_bw(base_size = 12) +
theme(panel.grid = element_blank(), panel.border = element_rect(colour = "black", fill=NA, linewidth = 1),
plot.title = element_text(size = 11), legend.title = element_text(size = 10, face = "bold")) +
guides(fill = guide_legend(override.aes = list(alpha = 0.6)), color = guide_legend(override.aes = list(size = 3))) +
coord_fixed(xlim = c(-27, 27), ylim = c(-27, 27)) # Limits set here prevent ellipse clipping
}
# Configuration
rds_input_path <- "Input_files/Phyloseq_genus.rds"
output_dir     <- "Plots"
selected_fert  <- c("N1P2K2", "N1K1", "M1P1")
if (!dir.exists(output_dir)) dir.create(output_dir, recursive = TRUE)
# Run Preparation
analysis_df <- prepare_dataset_phyloseq(rds_input_path, selected_fert, 8000)
setwd("..")
output_dir     <- "Figures/Plots"
# Configuration
rds_input_path <- "Input_files/Phyloseq_genus.rds"
selected_fert  <- c("N1P2K2", "N1K1", "M1P1")
if (!dir.exists(output_dir)) dir.create(output_dir, recursive = TRUE)
# Run Preparation
analysis_df <- prepare_dataset_phyloseq(rds_input_path, selected_fert, 8000)
# Run Plotting
p_final <- calculate_plot_tsne_final(analysis_df, c("response_var", "Fertilizer", "Time"))
# Display and Save
print(p_final)
# Plot
ggplot(df, aes(x = Dim1, y = Dim2)) +
stat_ellipse(aes(fill = response_var), geom = "polygon", alpha = 0.12, color = "black", linewidth = 0.2) +
geom_point(aes(color = Time, shape = Fertilizer), size = 2.2, alpha = 0.9) +
scale_color_manual(values = time_palette, name = "Time") +
scale_fill_manual(values = c("early" = "#e0f3f8", "middle" = "#e6f5d0", "late" = "#fee0d2"),
name = "Growth period", labels = c("Early", "Middle", "Late")) +
scale_shape_manual(values = c("M1P1" = 16, "N1K1" = 17, "N1P2K2" = 15), name = "Fertility Level") +
scale_y_continuous(breaks = seq(-20, 20, by = 10)) +
scale_x_continuous(breaks = seq(-20, 20, by = 10)) +
labs(x = "t-SNE 1", y = "t-SNE 2" ) +
theme_bw(base_size = 12) +
theme(panel.grid = element_blank(), panel.border = element_rect(colour = "black", fill=NA, linewidth = 1),
plot.title = element_text(size = 11), legend.title = element_text(size = 10, face = "bold")) +
guides(fill = guide_legend(override.aes = list(alpha = 0.7)), color = guide_legend(override.aes = list(size = 3))) +
coord_fixed(xlim = c(-27, 27), ylim = c(-27, 27)) # Limits set here prevent ellipse clipping
calculate_plot_tsne_final <- function(data, metadata_cols, seed = 42, perplexity = 30) {
prep <- prepare_plot_data(data, metadata_cols)
dist_matrix <- vegan::vegdist(prep$features, method = "bray")
set.seed(seed)
tsne_res <- Rtsne::Rtsne(dist_matrix, is_distance = TRUE, dims = 2,
perplexity = min(perplexity, floor((nrow(prep$features) - 1) / 3)))
df <- data.frame(tsne_res$Y, prep$metadata)
colnames(df)[1:2] <- c("Dim1", "Dim2")
# Order Factors
time_lvls <- c("11DAS", "14DAS", "17DAS", "31DAS", "158DAS", "187DAS", "215DAS", "227DAS", "256DAS", "318DAS")
df$Time <- factor(df$Time, levels = intersect(time_lvls, unique(df$Time)))
df$response_var <- factor(df$response_var, levels = c("early", "middle", "late"))
# Color Palette (Red -> Orange -> Yellow -> Green -> Blue -> Purple)
ref_colors <- c("#800026", "#bd0026", "#e31a1c", "#fc4e2a", "#fd8d3c", "#feb24c", "#fed976", "#c7e9b4", "#7fcdbb", "#41b6c4", "#1d91c0", "#225ea8", "#0c2c84", "#4b0082")
time_palette <- colorRampPalette(ref_colors)(length(levels(df$Time)))
# Plot
ggplot(df, aes(x = Dim1, y = Dim2)) +
stat_ellipse(aes(fill = response_var), geom = "polygon", alpha = 0.12, color = "black", linewidth = 0.2) +
geom_point(aes(color = Time, shape = Fertilizer), size = 2.2, alpha = 0.9) +
scale_color_manual(values = time_palette, name = "Time") +
scale_fill_manual(values = c("early" = "#e0f3f8", "middle" = "#e6f5d0", "late" = "#fee0d2"),
name = "Growth period", labels = c("Early", "Middle", "Late")) +
scale_shape_manual(values = c("M1P1" = 16, "N1K1" = 17, "N1P2K2" = 15), name = "Fertility Level") +
scale_y_continuous(breaks = seq(-20, 20, by = 10)) +
scale_x_continuous(breaks = seq(-20, 20, by = 10)) +
labs(x = "t-SNE 1", y = "t-SNE 2" ) +
theme_bw(base_size = 12) +
theme(panel.grid = element_blank(), panel.border = element_rect(colour = "black", fill=NA, linewidth = 1),
plot.title = element_text(size = 11), legend.title = element_text(size = 10, face = "bold")) +
guides(fill = guide_legend(override.aes = list(alpha = 0.7)), color = guide_legend(override.aes = list(size = 3))) +
coord_fixed(xlim = c(-27, 27), ylim = c(-27, 27)) # Limits set here prevent ellipse clipping
}
# Run Preparation
analysis_df <- prepare_dataset_phyloseq(rds_input_path, selected_fert, 8000)
# Run Plotting
p_final <- calculate_plot_tsne_final(analysis_df, c("response_var", "Fertilizer", "Time"))
# Display and Save
print(p_final)
ggsave(file.path(output_dir, "Figure2.png"), p_final, width = 8, height = 7, dpi = 300)
