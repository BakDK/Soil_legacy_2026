# 2. Create wrapper that fixes the rotation
ellipEncGrob_fixed <- function(points, expand = 0, radius = NULL, n = 100, ...) {
# Compute covariance and eigenvectors (same as ggforce)
S <- cov(points)
eig <- eigen(S)
# --- PATCH: enforce stable orientation ---
# Ensure major axis is first
if (eig$values[1] < eig$values[2]) {
eig$vectors <- eig$vectors[, c(2,1)]
eig$values  <- eig$values[c(2,1)]
}
# Compute angle
angle <- atan2(eig$vectors[2,1], eig$vectors[1,1])
# Prevent 180-degree flips
if (eig$vectors[1,1] < 0) {
angle <- angle + pi
}
# Call original function to build grob
grob <- ellipEncGrob_orig(points, expand = expand, radius = radius, n = n, ...)
# Overwrite the angle inside the grob
grob$angle <- angle
grob
}
# 3. Inject patched version into ggforce
assignInNamespace("ellipEncGrob", ellipEncGrob_fixed, ns = "ggforce")
