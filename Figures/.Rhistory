amp2_all6$metadata$Fert[amp2_all6$metadata$Fertilizer %in% "M1P1"]<-"M"
amp2_all6$metadata$Fert[amp2_all6$metadata$Fertilizer %in% "N1K1"]<-"NK"
amp2_all6$metadata$Fert[amp2_all6$metadata$Fertilizer %in% "N1P2K2"]<-"NPK"
amp2_all6$metadata$Period[amp2_all6$metadata$Time %in% c("11","14","17","31")]<-"Early"
amp2_all6$metadata$Period[amp2_all6$metadata$Time %in% c("158","187","215","227")]<-"Middle"
amp2_all6$metadata$Period[amp2_all6$metadata$Time %in% c("256","318")]<-"Late"
amp2_all6$metadata$Period[amp2_all6$metadata$Time %in% c("3DBS")]<-"Bulk Soil"
# Plot
heatmap_v1<-amp2_all6 %>% amp_subset_samples(!Time %in% c("T0","T1")) %>%
amp_heatmap(facet_by = c("Time"), group_by = "Fert", tax_show = 45,
tax_aggregate = "Genus",
normalise = FALSE,
plot_values = FALSE,
order_y_by = rev(genus_ranked_mean$Genus),
color_vector = c("White","Blue"))+
theme(strip.background = element_rect(fill="white", color = "white"))+
theme(axis.text.x = element_text(size = 9, angle = 90), axis.title = element_text(size = 22), axis.text.y = element_text(size = 10))+
labs(colour = "Rel. abundance (%)")
heatmap_v1
ggsave("Plots/Figure4.png", dpi = 300)
setwd("Figures")
x11(width = 9, height =7)
heatmap_v1
