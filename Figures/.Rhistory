angle <- atan2(eig$vectors[2,1], eig$vectors[1,1])
# Prevent 180-degree flips
if (eig$vectors[1,1] < 0) {
angle <- angle + pi
}
})
))
# 3. Inject patched version into ggforce namespace
assignInNamespace(
"ellipEncGrob",
ellipEncGrob_fixed,
ns = "ggforce"
)
