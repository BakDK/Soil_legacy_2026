# 2. Create patched version
ellipEncGrob_fixed <- function(points, expand = 0, radius = NULL, n = 100, ...) {
# --- original code up to eigen decomposition ---
center <- colMeans(points)
S <- cov(points)
# --- PATCH START: stable eigenvector orientation ---
eig <- eigen(S)
# Ensure major axis is first
if (eig$values[1] < eig$values[2]) {
eig$vectors <- eig$vectors[, c(2,1)]
eig$values  <- eig$values[c(2,1)]
}
# Compute angle
angle <- atan2(eig$vectors[2,1], eig$vectors[1,1])
# Prevent 180-degree flips
if (eig$vectors[1,1] < 0) {
angle <- angle + pi
}
# --- PATCH END ---
# Compute ellipse radii
axes <- sqrt(eig$values)
# Generate ellipse points
t <- seq(0, 2*pi, length.out = n)
ellipse <- cbind(
axes[1] * cos(t),
axes[2] * sin(t)
)
# Rotate
R <- matrix(c(cos(angle), -sin(angle), sin(angle), cos(angle)), 2, 2)
ellipse <- t(R %*% t(ellipse))
# Translate
ellipse <- sweep(ellipse, 2, center, "+")
# Return grob
orig(points = ellipse, expand = expand, radius = radius, n = n, ...)
}
# 3. Inject patched version into ggforce
assignInNamespace("ellipEncGrob", ellipEncGrob_fixed, ns = "ggforce")
message("geom_mark_ellipse orientation patched successfully.")
